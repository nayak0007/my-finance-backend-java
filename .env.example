PORT=3000

# Local: jdbc:postgresql://localhost:5432/finance
# Neon pooled connection (ssl required; prefer this from Render):
# postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# jdbc:postgresql://ep-xxx-pooler.REGION.aws.neon.tech/neondb?user=USER&password=PASSWORD&sslmode=require
# Libpq and JDBC URLs are accepted. Public remote hosts get sslmode=require automatically.
DATABASE_URL=jdbc:postgresql://localhost:5432/finance
DATABASE_USER=finance
DATABASE_PASSWORD=finance

# Neon Auth base URL from Console → Auth (no trailing slash).
# Example: https://ep-xxx.neonauth.REGION.aws.neon.tech/neondb/auth
NEON_AUTH_URL=
# Optional HS256 secret for local tests. Omit in production to verify Neon JWTs via JWKS (EdDSA).
NEON_JWT_SECRET=
# Origin header sent on server-to-server Neon Auth calls. Better Auth rejects POSTs
# without an Origin (MISSING_ORIGIN) unless the body has an absolute callbackURL.
# Must be one of your trusted origins (Neon Console → Auth → Trusted domains).
# Falls back to the first CORS_ORIGINS entry when unset.
NEON_AUTH_ORIGIN=

OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Gmail sync (Smart Import → Connect email). Google Cloud OAuth client of type
# "Web application". The redirect URI must be added to the client's authorized
# redirect URIs and be reachable from the user's browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/sync/gmail/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly

# AES key for encrypting Google refresh tokens at rest. Falls back to
# NEON_JWT_SECRET when blank; either must be set for Gmail sync to work.
SYNC_ENCRYPTION_KEY=

CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8080
SEED_USER_ID=00000000-0000-4000-8000-000000000001

# Where the password-recovery email link sends the user after Neon Auth verifies
# the one-time token. Use a deep link into the app (e.g. myfinancetracker://reset-password)
# or a web URL. When set, this is the fallback if the app does not send redirect_url.
AUTH_REDIRECT_URL=
