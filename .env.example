PORT=3000

# Local: jdbc:postgresql://localhost:5432/finance
# Supabase session pooler (ssl required):
# jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?user=postgres.<project-ref>&password=YOUR_PASSWORD&sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/finance
DATABASE_USER=finance
DATABASE_PASSWORD=finance

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:8080
SEED_USER_ID=00000000-0000-4000-8000-000000000001
